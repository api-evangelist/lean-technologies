                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"9a1b3c5d-7e8f-4a2b-8c6d-0e1f2a3b4c5d\",\n  \"state\": \"COMPLETED\",\n  \"customer_id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"type\": \"PAY\",\n  \"session_url\": \"https://secure.leantech.me/9a1b3c5d-7e8f-4a2b-8c6d-0e1f2a3b4c5d\",\n  \"redirect_url\": \"https://example.com/checkout/complete?order_id=ord_1234\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
